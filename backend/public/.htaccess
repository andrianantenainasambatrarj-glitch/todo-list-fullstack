DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Transmet l'en-tête Authorization à PHP (indispensable pour le JWT)
    RewriteCond %{HTTP:Authorization} .+
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%0]

    # Si le fichier demandé existe, le servir tel quel
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Sinon, tout envoyer au contrôleur frontal Symfony
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule !mod_rewrite.c>
    <IfModule mod_alias.c>
        RedirectMatch 307 ^/$ /index.php/
    </IfModule>
</IfModule>
